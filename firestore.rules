rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products catalog (Rarumi healthy menu items)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Transactions (sales orders and receipts)
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isValidId(transactionId);
      allow update, delete: if isValidId(transactionId);
    }
  }
}
